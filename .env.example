# Desenvolvimento local: copie para .env. Os valores batem com o docker-compose.dev.yml.
DATABASE_URL=postgresql://dev:dev@localhost:5432/validadocs?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dev
MINIO_SECRET_KEY=devdevdev
MINIO_BUCKET=validadocs
MINIO_USE_SSL=false

# Obrigatória, com 32+ caracteres. Gere com: openssl rand -hex 32
# Em produção vai no ambiente do Dokploy; sem ela o docker-compose.yml não sobe.
SESSION_SECRET=
